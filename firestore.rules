rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isBootstrappedAdmin() {
      return isSignedIn() &&
             request.auth.token.email == 'kevinarias.8818@gmail.com' &&
             request.auth.token.email_verified == true;
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveStaff() {
      return isSignedIn() &&
             userDocExists() &&
             userDoc().active == true &&
             userDoc().role in ['ADMIN', 'OPERATOR', 'DIAMANTE_ALMA'];
    }

    function isAdmin() {
      return isBootstrappedAdmin() ||
             (isActiveStaff() && userDoc().role == 'ADMIN');
    }

    function isDiamanteAlma() {
      return isActiveStaff() && userDoc().role == 'DIAMANTE_ALMA';
    }

    function userUnitId() {
      return userDoc().unitId;
    }

    // --- Entity Validation Helpers ---
    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             data.role in ['PENDING', 'ADMIN', 'OPERATOR', 'DIAMANTE_ALMA'] &&
             data.unitId is string && data.unitId.size() >= 2 && data.unitId.size() <= 64 &&
             data.active is bool &&
             (data.role != 'PENDING' || data.active == false) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidFcmToken(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.token is string && data.token.size() >= 10 && data.token.size() <= 512 &&
             data.platform == 'ANDROID' &&
             data.unitId is string && data.unitId.size() >= 2 && data.unitId.size() <= 64 &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidEntry(data) {
      return data.unitId is string && data.unitId.size() >= 2 && data.unitId.size() <= 64 &&
             data.entryDate is string && data.entryDate.size() == 10 && data.entryDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             (!('rank' in data) || (data.rank is string && data.rank.size() <= 40)) &&
             data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 120 &&
             data.documentNumber is string && data.documentNumber.size() >= 1 && data.documentNumber.size() <= 40 &&
             data.plate is string && data.plate.size() <= 20 &&
             (!('plateImageName' in data) || (data.plateImageName is string && data.plateImageName.size() <= 160)) &&
             (!('plateImageData' in data) || (
               data.plateImageData is string &&
               data.plateImageData.size() >= 29 &&
               data.plateImageData.size() <= 250000 &&
               (
                 data.plateImageData[0:23] == 'data:image/jpeg;base64,' ||
                 data.plateImageData[0:22] == 'data:image/png;base64,' ||
                 data.plateImageData[0:23] == 'data:image/webp;base64,'
               )
             )) &&
             data.destinationUnit is string && data.destinationUnit.size() >= 1 && data.destinationUnit.size() <= 80 &&
             (!('reason' in data) || (data.reason is string && data.reason.size() <= 160)) &&
             data.visitorType in ['PERSONAL', 'VISITANTE', 'PROVEEDOR', 'CONTRATISTA'] &&
             data.expectedTime is string && data.expectedTime.size() <= 20 &&
             data.source in ['MANUAL', 'CORREO_INSTITUCIONAL'] &&
             data.notes is string && data.notes.size() <= 300 &&
             data.status in ['PENDIENTE', 'INGRESO', 'SALIDA'] &&
             data.createdByUid is string && data.createdByUid.size() >= 1 && data.createdByUid.size() <= 128 &&
             data.createdByName is string && data.createdByName.size() >= 1 && data.createdByName.size() <= 120 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time &&
             (!('restoredAt' in data) || (data.restoredAt is timestamp && data.restoredAt <= request.time)) &&
             (!('checkInAt' in data) || (data.checkInAt is timestamp && data.checkInAt <= request.time)) &&
             (!('checkInByUid' in data) || (data.checkInByUid is string && data.checkInByUid.size() >= 1 && data.checkInByUid.size() <= 128)) &&
             (!('checkInByName' in data) || (data.checkInByName is string && data.checkInByName.size() >= 1 && data.checkInByName.size() <= 120)) &&
             (!('checkOutAt' in data) || (data.checkOutAt is timestamp && data.checkOutAt <= request.time)) &&
             (!('checkOutByUid' in data) || (data.checkOutByUid is string && data.checkOutByUid.size() >= 1 && data.checkOutByUid.size() <= 128)) &&
             (!('checkOutByName' in data) || (data.checkOutByName is string && data.checkOutByName.size() >= 1 && data.checkOutByName.size() <= 120)) &&
             (
               (data.status == 'PENDIENTE' &&
                !('checkInAt' in data) && !('checkInByUid' in data) && !('checkInByName' in data) &&
                !('checkOutAt' in data) && !('checkOutByUid' in data) && !('checkOutByName' in data)) ||
               (data.status == 'INGRESO' &&
                ('checkInAt' in data) && ('checkInByUid' in data) && ('checkInByName' in data) &&
                !('checkOutAt' in data) && !('checkOutByUid' in data) && !('checkOutByName' in data)) ||
               (data.status == 'SALIDA' &&
                ('checkInAt' in data) && ('checkInByUid' in data) && ('checkInByName' in data) &&
                ('checkOutAt' in data) && ('checkOutByUid' in data) && ('checkOutByName' in data))
             );
    }

    function isValidTrashedEntry(data) {
      return isValidEntry(data) &&
             data.deletedAt is timestamp && data.deletedAt <= request.time &&
             data.deletedByUid is string && data.deletedByUid.size() >= 1 && data.deletedByUid.size() <= 128 &&
             data.deletedByName is string && data.deletedByName.size() >= 1 && data.deletedByName.size() <= 120;
    }

    // --- Collection: /users/{userId} ---
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      // Create: New users self-register strictly as PENDING (inactive, no entries access).
      // Only Bootstrapped Admin can self-register as ADMIN, and only Admin can grant OPERATOR/DIAMANTE_ALMA/ADMIN.
      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().keys().hasAll(['userId', 'email', 'displayName', 'role', 'unitId', 'active', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'email', 'displayName', 'role', 'unitId', 'active', 'createdAt', 'updatedAt']) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().unitId == 'UNIDAD_PRINCIPAL' &&
                       (
                         (incoming().role == 'PENDING' && incoming().active == false) ||
                         (incoming().role == 'ADMIN' && incoming().active == true && isBootstrappedAdmin())
                       );

      // Update: Self can only update displayName + updatedAt. Admin can update role, active, displayName, updatedAt.
      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().email == existing().email &&
                       incoming().unitId == existing().unitId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         (request.auth.uid == userId &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt'])) ||
                         (isAdmin() &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role', 'active', 'updatedAt']))
                       );

      allow delete: if false;

      match /fcmTokens/{tokenId} {
        allow get: if isSignedIn() && isValidId(tokenId) && (request.auth.uid == userId || isAdmin());
        allow list: if isSignedIn() && (request.auth.uid == userId || isAdmin());

        allow create: if isSignedIn() &&
                         isValidId(tokenId) &&
                         request.auth.uid == userId &&
                         isActiveStaff() &&
                         isValidFcmToken(incoming()) &&
                         incoming().keys().hasAll(['userId', 'token', 'platform', 'unitId', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'token', 'platform', 'unitId', 'updatedAt']) &&
                         incoming().userId == request.auth.uid &&
                         incoming().unitId == userUnitId();

        allow update: if isSignedIn() &&
                         isValidId(tokenId) &&
                         request.auth.uid == userId &&
                         isActiveStaff() &&
                         isValidFcmToken(incoming()) &&
                         incoming().keys().hasAll(['userId', 'token', 'platform', 'unitId', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'token', 'platform', 'unitId', 'updatedAt']) &&
                         incoming().userId == existing().userId &&
                         incoming().unitId == existing().unitId;

        allow delete: if isSignedIn() && isValidId(tokenId) && (request.auth.uid == userId || isAdmin());
      }
    }

    // --- Collection: /entries/{entryId} ---
    match /entries/{entryId} {
      allow get: if isSignedIn() &&
                    isValidId(entryId) &&
                    isActiveStaff() &&
                    existing().unitId == userUnitId();

      allow list: if isSignedIn() &&
                     isActiveStaff() &&
                     existing().unitId == userUnitId();

      // Active Admins & Diamante Alma can create new entries; only Admins can restore from trashedEntries
      allow create: if isSignedIn() &&
                       isValidId(entryId) &&
                       isValidEntry(incoming()) &&
                       incoming().keys().hasAll([
                         'unitId', 'entryDate', 'fullName', 'documentNumber', 'plate',
                         'destinationUnit', 'visitorType', 'expectedTime', 'source',
                         'notes', 'status', 'createdByUid', 'createdByName', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'unitId', 'entryDate', 'rank', 'fullName', 'documentNumber', 'plate',
                         'plateImageName', 'plateImageData',
                         'destinationUnit', 'reason', 'visitorType', 'expectedTime', 'source',
                         'notes', 'status', 'checkInAt', 'checkInByUid', 'checkInByName',
                         'checkOutAt', 'checkOutByUid', 'checkOutByName',
                         'createdByUid', 'createdByName', 'createdAt', 'updatedAt', 'restoredAt'
                       ]) &&
                       incoming().unitId == userUnitId() &&
                       (
                         ((isAdmin() || isDiamanteAlma()) &&
                          incoming().createdByUid == request.auth.uid &&
                          !('restoredAt' in incoming())) ||
                         (isAdmin() &&
                          exists(/databases/$(database)/documents/trashedEntries/$(entryId)) &&
                          !existsAfter(/databases/$(database)/documents/trashedEntries/$(entryId)) &&
                          get(/databases/$(database)/documents/trashedEntries/$(entryId)).data.unitId == incoming().unitId)
                       );

      // Tiered Update:
      // 1. Admin can edit fields or adjust status
      // 2. Active staff (OPERATOR / DIAMANTE_ALMA / ADMIN) can check in PENDIENTE -> INGRESO, check out INGRESO -> SALIDA, or attach plate image
      allow update: if isSignedIn() &&
                       isValidId(entryId) &&
                       isValidEntry(incoming()) &&
                       incoming().unitId == existing().unitId &&
                       incoming().createdByUid == existing().createdByUid &&
                       incoming().createdByName == existing().createdByName &&
                       incoming().createdAt == existing().createdAt &&
                       isActiveStaff() &&
                       existing().unitId == userUnitId() &&
                       (
                         (isAdmin() &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'entryDate', 'rank', 'fullName', 'documentNumber', 'plate',
                            'plateImageName', 'plateImageData',
                            'destinationUnit', 'reason', 'visitorType', 'expectedTime', 'source',
                            'notes', 'status', 'checkInAt', 'checkInByUid', 'checkInByName',
                            'checkOutAt', 'checkOutByUid', 'checkOutByName', 'updatedAt'
                          ])) ||
                         (existing().status == 'PENDIENTE' &&
                          incoming().status == 'INGRESO' &&
                          incoming().checkInByUid == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'status', 'checkInAt', 'checkInByUid', 'checkInByName',
                            'plateImageName', 'plateImageData', 'updatedAt'
                          ])) ||
                         (existing().status == 'INGRESO' &&
                          incoming().status == 'SALIDA' &&
                          incoming().checkOutByUid == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'status', 'checkOutAt', 'checkOutByUid', 'checkOutByName', 'updatedAt'
                          ])) ||
                         (existing().status in ['PENDIENTE', 'INGRESO'] &&
                          incoming().status == existing().status &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'plateImageName', 'plateImageData', 'updatedAt'
                          ]))
                       );

      // Soft delete ONLY: Admin or Diamante Alma can delete an active entry only when atomically moving it to /trashedEntries
      allow delete: if isSignedIn() &&
                       isValidId(entryId) &&
                       (isAdmin() || isDiamanteAlma()) &&
                       existing().unitId == userUnitId() &&
                       existsAfter(/databases/$(database)/documents/trashedEntries/$(entryId));
    }

    // --- Collection: /trashedEntries/{entryId} ---
    // Strict Admin-only visibility, restore, and permanent deletion.
    // Diamante Alma can ONLY move an existing active /entries doc here via atomic batch.
    match /trashedEntries/{entryId} {
      allow get: if isSignedIn() &&
                    isValidId(entryId) &&
                    isAdmin() &&
                    existing().unitId == userUnitId();

      allow list: if isSignedIn() &&
                     isAdmin() &&
                     existing().unitId == userUnitId();

      allow create: if isSignedIn() &&
                       isValidId(entryId) &&
                       (isAdmin() || isDiamanteAlma()) &&
                       isValidTrashedEntry(incoming()) &&
                       incoming().keys().hasAll([
                         'unitId', 'entryDate', 'fullName', 'documentNumber', 'plate',
                         'destinationUnit', 'visitorType', 'expectedTime', 'source',
                         'notes', 'status', 'createdByUid', 'createdByName', 'createdAt', 'updatedAt',
                         'deletedAt', 'deletedByUid', 'deletedByName'
                       ]) &&
                       incoming().keys().hasOnly([
                         'unitId', 'entryDate', 'rank', 'fullName', 'documentNumber', 'plate',
                         'plateImageName', 'plateImageData',
                         'destinationUnit', 'reason', 'visitorType', 'expectedTime', 'source',
                         'notes', 'status', 'checkInAt', 'checkInByUid', 'checkInByName',
                         'checkOutAt', 'checkOutByUid', 'checkOutByName',
                         'createdByUid', 'createdByName', 'createdAt', 'updatedAt', 'restoredAt',
                         'deletedAt', 'deletedByUid', 'deletedByName'
                       ]) &&
                       incoming().unitId == userUnitId() &&
                       incoming().deletedByUid == request.auth.uid &&
                       exists(/databases/$(database)/documents/entries/$(entryId)) &&
                       !existsAfter(/databases/$(database)/documents/entries/$(entryId)) &&
                       get(/databases/$(database)/documents/entries/$(entryId)).data.unitId == userUnitId();

      allow update: if false;

      allow delete: if isSignedIn() &&
                       isValidId(entryId) &&
                       isAdmin() &&
                       existing().unitId == userUnitId();
    }
  }
}
