{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Perfil y rol de acceso del personal autorizado en la unidad.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "UID de Firebase Auth del usuario."
        },
        "email": {
          "type": "string",
          "description": "Correo electrónico verificado de Google Sign-In."
        },
        "displayName": {
          "type": "string",
          "description": "Nombre visible del usuario en turno."
        },
        "role": {
          "type": "string",
          "enum": ["PENDING", "ADMIN", "OPERATOR", "DIAMANTE_ALMA"],
          "description": "Rol asignado: PENDING (Sin acceso hasta aprobación), ADMIN (Encargado de Seguridad), OPERATOR (Control de Garita) o DIAMANTE_ALMA (Registro de ingresos y envío a papelera)."
        },
        "unitId": {
          "type": "string",
          "description": "Identificador de la unidad operativa."
        },
        "active": {
          "type": "boolean",
          "description": "Indica si el usuario tiene acceso activo."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Fecha de creación (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Última actualización (FieldValue.serverTimestamp())."
        }
      },
      "required": [
        "userId",
        "email",
        "displayName",
        "role",
        "unitId",
        "active",
        "createdAt",
        "updatedAt"
      ]
    },
    "AccessEntry": {
      "title": "AccessEntry",
      "description": "Registro diario de ingreso autorizado de personal, visitantes, proveedores o contratistas.",
      "type": "object",
      "properties": {
        "unitId": {
          "type": "string",
          "description": "Identificador de la unidad operativa."
        },
        "entryDate": {
          "type": "string",
          "description": "Fecha programada de ingreso en formato YYYY-MM-DD."
        },
        "rank": {
          "type": "string",
          "description": "Grado, cargo o tratamiento (ej. Cabo, Teniente, Ing., Sr.)."
        },
        "fullName": {
          "type": "string",
          "description": "Nombre completo de la persona autorizada."
        },
        "documentNumber": {
          "type": "string",
          "description": "Número de cédula o identificación."
        },
        "plate": {
          "type": "string",
          "description": "Placa del vehículo o vacío si es peatonal."
        },
        "plateImageName": {
          "type": "string",
          "description": "Nombre del archivo de imagen adjunto de la placa vehicular."
        },
        "plateImageData": {
          "type": "string",
          "description": "Imagen comprimida de la placa vehicular en formato Data URL (data:image/jpeg;base64,...)."
        },
        "destinationUnit": {
          "type": "string",
          "description": "Dependencia o unidad destino."
        },
        "reason": {
          "type": "string",
          "description": "Motivo del ingreso (ej. Relevo de turno, Reunión, Mantenimiento)."
        },
        "visitorType": {
          "type": "string",
          "enum": ["PERSONAL", "VISITANTE", "PROVEEDOR", "CONTRATISTA"],
          "description": "Categoría de ingreso."
        },
        "expectedTime": {
          "type": "string",
          "description": "Hora programada de ingreso (HH:mm)."
        },
        "source": {
          "type": "string",
          "enum": ["MANUAL", "CORREO_INSTITUCIONAL"],
          "description": "Origen del registro."
        },
        "notes": {
          "type": "string",
          "description": "Observaciones del ingreso."
        },
        "status": {
          "type": "string",
          "enum": ["PENDIENTE", "INGRESO", "SALIDA"],
          "description": "Estado actual del ingreso."
        },
        "checkInAt": {
          "type": "string",
          "format": "date-time",
          "description": "Fecha y hora efectiva de ingreso (FieldValue.serverTimestamp())."
        },
        "checkInByUid": {
          "type": "string",
          "description": "UID del operador o administrador que marcó el ingreso."
        },
        "checkInByName": {
          "type": "string",
          "description": "Nombre visible de quien marcó el ingreso."
        },
        "checkOutAt": {
          "type": "string",
          "format": "date-time",
          "description": "Fecha y hora efectiva de salida (FieldValue.serverTimestamp())."
        },
        "checkOutByUid": {
          "type": "string",
          "description": "UID del operador o administrador que marcó la salida."
        },
        "checkOutByName": {
          "type": "string",
          "description": "Nombre visible de quien marcó la salida."
        },
        "createdByUid": {
          "type": "string",
          "description": "UID del administrador que creó el registro."
        },
        "createdByName": {
          "type": "string",
          "description": "Nombre del administrador que creó el registro."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Fecha de creación (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Última actualización (FieldValue.serverTimestamp())."
        },
        "restoredAt": {
          "type": "string",
          "format": "date-time",
          "description": "Marca de restauración desde la papelera (opcional)."
        }
      },
      "required": [
        "unitId",
        "entryDate",
        "fullName",
        "documentNumber",
        "plate",
        "destinationUnit",
        "visitorType",
        "expectedTime",
        "source",
        "notes",
        "status",
        "createdByUid",
        "createdByName",
        "createdAt",
        "updatedAt"
      ]
    },
    "TrashedEntry": {
      "title": "TrashedEntry",
      "description": "Registro de ingreso enviado a la papelera (borrado lógico), visible únicamente para Administrador.",
      "type": "object",
      "properties": {
        "unitId": { "type": "string" },
        "entryDate": { "type": "string" },
        "rank": { "type": "string" },
        "fullName": { "type": "string" },
        "documentNumber": { "type": "string" },
        "plate": { "type": "string" },
        "plateImageName": { "type": "string" },
        "plateImageData": { "type": "string" },
        "destinationUnit": { "type": "string" },
        "reason": { "type": "string" },
        "visitorType": {
          "type": "string",
          "enum": ["PERSONAL", "VISITANTE", "PROVEEDOR", "CONTRATISTA"]
        },
        "expectedTime": { "type": "string" },
        "source": {
          "type": "string",
          "enum": ["MANUAL", "CORREO_INSTITUCIONAL"]
        },
        "notes": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["PENDIENTE", "INGRESO", "SALIDA"]
        },
        "checkInAt": { "type": "string", "format": "date-time" },
        "checkInByUid": { "type": "string" },
        "checkInByName": { "type": "string" },
        "checkOutAt": { "type": "string", "format": "date-time" },
        "checkOutByUid": { "type": "string" },
        "checkOutByName": { "type": "string" },
        "createdByUid": { "type": "string" },
        "createdByName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "restoredAt": { "type": "string", "format": "date-time" },
        "deletedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Fecha y hora de envío a la papelera (FieldValue.serverTimestamp())."
        },
        "deletedByUid": {
          "type": "string",
          "description": "UID del usuario (ADMIN o DIAMANTE_ALMA) que envió el ingreso a la papelera."
        },
        "deletedByName": {
          "type": "string",
          "description": "Nombre visible de quien envió el ingreso a la papelera."
        }
      },
      "required": [
        "unitId",
        "entryDate",
        "fullName",
        "documentNumber",
        "plate",
        "destinationUnit",
        "visitorType",
        "expectedTime",
        "source",
        "notes",
        "status",
        "createdByUid",
        "createdByName",
        "createdAt",
        "updatedAt",
        "deletedAt",
        "deletedByUid",
        "deletedByName"
      ]
    },
    "FcmToken": {
      "title": "FcmToken",
      "description": "Token de dispositivo Android para notificaciones push FCM de administradores.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "UID del administrador dueño del dispositivo."
        },
        "token": {
          "type": "string",
          "description": "Token de registro de Firebase Cloud Messaging."
        },
        "platform": {
          "type": "string",
          "enum": ["ANDROID"],
          "description": "Plataforma del dispositivo."
        },
        "unitId": {
          "type": "string",
          "description": "Unidad operativa asignada."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Última sincronización del token (FieldValue.serverTimestamp())."
        }
      },
      "required": ["userId", "token", "platform", "unitId", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Perfiles y roles de acceso de personal y administradores."
    },
    "/users/{userId}/fcmTokens/{tokenId}": {
      "schema": { "$ref": "#/entities/FcmToken" },
      "description": "Tokens FCM de dispositivos de administradores para alertas de ingresos."
    },
    "/entries/{entryId}": {
      "schema": { "$ref": "#/entities/AccessEntry" },
      "description": "Registros activos de ingresos diarios de personal y visitantes."
    },
    "/trashedEntries/{entryId}": {
      "schema": { "$ref": "#/entities/TrashedEntry" },
      "description": "Papelera de ingresos borrados lógicamente (acceso exclusivo de Administrador)."
    }
  }
}
